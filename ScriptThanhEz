-- ==========================================================
-- THANH EZ HUB : COMBAT & MOVEMENT SETTINGS MODULE
-- ==========================================================

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Variables for Fast Attack
local FastAttackConnection = nil

-- Variables for Fly Speed
local FlyConnection = nil
local IsFlying = false
local CurrentFlySpeed = 300

local CombatModule = {}

-- ==========================================================
-- 1. FAST ATTACK LOGIC (Ultra-fast auto clicker)
-- ==========================================================
function CombatModule.ToggleFastAttack(state)
    if state then
        if not FastAttackConnection then
            FastAttackConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") and tool:FindFirstChild("RemoteEvent") then
                                tool.RemoteEvent:FireServer("Click")
                            end
                        end
                        local equippedTool = character:FindFirstChildOfClass("Tool")
                        if equippedTool and equippedTool:FindFirstChild("RemoteEvent") then
                            equippedTool.RemoteEvent:FireServer("Click")
                        end
                    end
                end)
            end)
        end
    else
        if FastAttackConnection then
            FastAttackConnection:Disconnect()
            FastAttackConnection = nil
        end
    end
end

-- ==========================================================
-- 2. FLY SPEED LOGIC (Dynamic speed when dragging slider)
-- ==========================================================
function CombatModule.ToggleFly(state)
    IsFlying = state
    local character = LocalPlayer.Character
    local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if IsFlying then
        if not FlyConnection and humanoidRootPart then
            FlyConnection = RunService.Heartbeat:Connect(function(dt)
                pcall(function()
                    if not IsFlying then return end
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and humanoid then
                        humanoid.PlatformStand = true
                        hrp.Velocity = Camera.CFrame.LookVector * CurrentFlySpeed
                    end
                end)
            end)
        end
    else
        if FlyConnection then
            FlyConnection:Disconnect()
            FlyConnection = nil
        end
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.PlatformStand = false
            end
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    end
end

function CombatModule.SetFlySpeed(newSpeed)
    CurrentFlySpeed = tonumber(newSpeed) or 300
end

return CombatModule
