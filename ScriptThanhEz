-- ==========================================================
-- CHECK IF BOSS IS ALIVE
-- ==========================================================
local function IsBossAvailable(mobName)
    if string.find(string.lower(mobName), "boss") or string.find(string.lower(mobName), "captain") then
        local enemies = Workspace:FindFirstChild("Enemies")
        if enemies then
            for _, mob in pairs(enemies:GetChildren()) do
                if mob.Name == mobName and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                    return true
                end
            end
        end
        return false
    end
    return true
end

-- ==========================================================
-- AUTOMATICALLY ACCEPT QUEST FROM REMOTES
-- ==========================================================
local function CheckAndAcceptQuest(questData)
    pcall(function()
        local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
        if not questGui or not questGui.Visible then
            local args = {
                [1] = "StartQuest",
                [2] = questData.QuestName,
                [3] = questData.QuestId
            }
            ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
        end
    end)
end

-- ==========================================================
-- MAIN AUTO FARM HEARTBEAT LOOP (Bring Mobs, Stay Above, Attack)
-- ==========================================================
function AutoFarmModule.ToggleAutoFarm(state)
    IsAutoFarmActive = state

    if IsAutoFarmActive then
        if not AutoFarmConnection then
            AutoFarmConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    if not IsAutoFarmActive then return end

                    local character = LocalPlayer.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if not hrp or not humanoid or humanoid.Health <= 0 then return end

                    local questInfo = GetCurrentQuestInfo()

                    if not IsBossAvailable(questInfo.MobName) then return end

                    CheckAndAcceptQuest(questInfo)

                    local enemiesFolder = Workspace:FindFirstChild("Enemies")
                    local targetFound = false

                    if enemiesFolder then
                        for _, mob in pairs(enemiesFolder:GetChildren()) do
                            if mob.Name == questInfo.MobName and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") then
                                local mobHumanoid = mob.Humanoid
                                local mobHrp = mob.HumanoidRootPart

                                if mobHumanoid.Health > 0 then
                                    targetFound = true
                                    -- Keep player floating safely above the mob zone
                                    hrp.CFrame = mobHrp.CFrame * CFrame.new(0, 25, 0) * CFrame.Angles(math.rad(90), 0, 0)
                                    
                                    -- Pin and lock all required mobs tightly under player feet
                                    mobHrp.CFrame = hrp.CFrame * CFrame.new(0, -25, -2)
                                    mobHrp.Velocity = Vector3.new(0, 0, 0)
                                    mobHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                    
                                    if mob:FindFirstChild("Head") then
                                        mob.Head.CanCollide = false
                                    end
                                    
                                    break
                                end
                            end
                        end
                    end

                    -- Automatically execute Fast Attack when enemies are locked
                    if targetFound then
                        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") and tool:FindFirstChild("RemoteEvent") then
                                tool.RemoteEvent:FireServer("Click")
                            end
                        end
                        local equippedTool = character:FindFirstChildOfClass("Tool")
                        if equippedTool and equippedTool:FindFirstChild("RemoteEvent") then
                            equippedTool.RemoteEvent:FireServer("Click")
                        end
                    end
                end)
            end)
        end
    else
        if AutoFarmConnection then
            AutoFarmConnection:Disconnect()
            AutoFarmConnection = nil
        end
        pcall(function()
            local char = LocalPlayer.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.PlatformStand = false end
        end)
    end
end

return AutoFarmModule
