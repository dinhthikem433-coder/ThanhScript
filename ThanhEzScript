end

local function CreateToggle(page, id, title, callback)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -10, 0, 36)
    toggleFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = page
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = toggleFrame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(230, 230, 230)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.Text = title
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggleFrame
    
    -- Redz Style Toggle Switch (Thanh gạt thuôn dài bên phải)
    local switchBtn = Instance.new("TextButton")
    switchBtn.Size = UDim2.new(0, 36, 0, 18)
    switchBtn.Position = UDim2.new(1, -44, 0.5, -9)
    switchBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    switchBtn.Text = ""
    switchBtn.Parent = toggleFrame
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switchBtn
    
    local currentState = ConfigData.Toggles[id] or false
    if currentState then
        switchBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        switchBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    end
    
    switchBtn.MouseButton1Click:Connect(function()
        currentState = not currentState
        ConfigData.Toggles[id] = currentState
        SaveConfig() -- Auto Save Config instantly
        
        if currentState then
            switchBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        else
            switchBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
        if callback then callback(currentState) end
    end)
end

