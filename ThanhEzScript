-- 1. CONFIG SYSTEM (Auto Save/Load Toggles & UI Size)
local ConfigFileName = "ThanhEzHub_RedzConfig.json"
local ConfigData = {
    Toggles = {},
    UISize = "Normal"
}

local function SaveConfig()
    pcall(function()
        if writefile then
            writefile(ConfigFileName, HttpService:JSONEncode(ConfigData))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFileName) then
            ConfigData = HttpService:JSONDecode(readfile(ConfigFileName))
        end
    end)
end

