-- 1. CONFIG SAVE / LOAD SYSTEM
local ConfigFileName = "ThanhEzHub_Config.json"
local ConfigData = {
    Toggles = {}
}

local function SaveConfig()
    local success, err = pcall(function()
        if writefile then
            writefile(ConfigFileName, HttpService:JSONEncode(ConfigData))
        end
    end)
    if not success then
        warn("[ThanhEz Hub]: Failed to save config: " .. tostring(err))
    end
end

local function LoadConfig()
    local success, err = pcall(function()
        if readfile and isfile and isfile(ConfigFileName) then
            ConfigData = HttpService:JSONDecode(readfile(ConfigFileName))
        end
    end)
    if not success then
        warn("[ThanhEz Hub]: Failed to load config: " .. tostring(err))
    end
end

